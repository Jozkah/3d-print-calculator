# The app runs with NO environment variables at all.
#
# Leave this file empty and every table lives in your browser's localStorage
# (see lib/local-db.ts) — no database, no API keys, nothing to configure:
#
#   npm install && npm run dev
#
# ---------------------------------------------------------------------------
# Optional: back the same app with Supabase instead
# ---------------------------------------------------------------------------
# Set BOTH variables and lib/supabase/client.ts switches to a real Postgres —
# no code changes anywhere else. Run scripts/migrations/*.sql in order against
# the project first. Setting only one of the two keeps the app on localStorage.
#
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
#
# Force local storage even when the credentials above are present — useful for
# a preview deployment that must not touch production data.
#
# NEXT_PUBLIC_DATA_BACKEND=local
