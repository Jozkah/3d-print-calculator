{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    // The local data layer (lib/local-db.ts) returns loosely-typed rows in place
    // of Supabase's generated types, so query results are `any`. Relax this one
    // check to keep the rest of strict mode without annotating every callback.
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // `include` above matches `**/*.ts`, which also reaches into .next. The
  // generated route types under .next/types and .next/dev/types are wanted, so
  // only the build/cache output is excluded — Turbopack's persistent cache
  // alone reached 685 MB / 1536 files, which the TS program has no business
  // crawling.
  "exclude": [
    "node_modules",
    ".next/cache",
    ".next/dev/cache",
    ".next/dev/static",
    ".next/server",
    ".next/static"
  ]
}
